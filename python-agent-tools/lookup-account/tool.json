{
    "id": "lookup-salesforce-account",
    "meta": {
        "icon": "icon-salesforce",
        "label": "Look up Salesforce Account",
        "description": "Look up a Salesforce account by name"
    },
    
    "params" : [
        {
            "name": "auth_type",
            "label": "Authentication method",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "oauth",
                    "label": "Salesforce SSO (per-user)"
                },
                {
                    "value": "oauth_client_credentials",
                    "label": "Client credentials"
                },
                {
                    "value": "oauth_jwt_bearer",
                    "label": "JWT bearer"
                },
                {
                    "value": "oauth_sandbox",
                    "label": "Salesforce Sandbox SSO (per-user)"
                },
                {
                    "value": "basic_login",
                    "label": "Salesforce login (legacy)"
                },
                {
                    "value": "legacy",
                    "label": "JSON token (legacy)"
                }
            ],
            "mandatory": true,
            "defaultValue": "oauth"
        },
        {
            "name": "oauth",
            "label": "Salesforce preset",
            "type": "PRESET",
            "parameterSetId": "oauth-credentials",
            "visibilityCondition": "model.auth_type == 'oauth'"
        },
        {
            "name": "oauth_sandbox",
            "label": "Salesforce Sandbox preset",
            "type": "PRESET",
            "parameterSetId": "oauth-sandbox-credentials",
            "visibilityCondition": "model.auth_type == 'oauth_sandbox'"
        },
        {
            "name": "oauth_jwt_bearer",
            "label": "JWT bearer",
            "type": "PRESET",
            "parameterSetId": "oauth-jwt-bearer",
            "visibilityCondition": "model.auth_type == 'oauth_jwt_bearer'"
        },
        {
            "name": "oauth_client_credentials",
            "label": "Client credentials",
            "type": "PRESET",
            "parameterSetId": "oauth-client-credentials",
            "visibilityCondition": "model.auth_type == 'oauth_client_credentials'"
        },
        {
            "name": "basic_login",
            "label": "Salesforce login",
            "type": "PRESET",
            "parameterSetId": "salesforce-login",
            "visibilityCondition": "model.auth_type == 'basic_login'"
        },
        {
            "name": "token",
            "label": "JSON token",
            "description": "JSON, or path to a file containing the JSON",
            "type": "STRING",
            "mandatory" : true,
            "defaultValue": "${dip.home}/SalesforceToken.json",
            "visibilityCondition": "model.auth_type == 'legacy'"
        }
    ]
}